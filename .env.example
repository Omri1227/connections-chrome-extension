# Copy to .env and fill in. Never commit .env.
# Flight-data server (flightdata/, docs/FLIGHT_DATA_ARCHITECTURE.md). Nothing is collected on a schedule until
# FD_ASSIGNMENTS lists a source, and keyed sources stay inactive without their key.
# Admin token for the research API/dashboard (falls back to ADMIN_TOKEN).
FD_ADMIN_TOKEN=
# Database: a PostgreSQL URL in production; locally a PGlite directory (default: %LOCALAPPDATA%\cdg-navigator\flightdata\pg,
# deliberately outside the OneDrive-synced repository).
# FD_DATABASE_URL=postgres://user:password@host:5432/flightdata?sslmode=require
# FD_PGLITE_DIR=
FD_PORT=8790
# Which source collects which airport. Only list sources you are licensed to use, e.g.:
#   FD_ASSIGNMENTS=CDG:aerodatabox,FCO:adr-fco-web,ARN:swedavia
FD_ASSIGNMENTS=
# Run the tick loop inside `npm run fd:server` (local operation). In production use a cron job running `npm run fd -- tick`.
FD_SCHEDULER=off
FD_TICK_MINUTES=15
FD_GRACE_HOURS=6
FD_RAW_RETENTION_DAYS=14
# Source keys (your own accounts only; never commit them)
# FD_AERODATABOX_KEY=
# API.Market: base below, header x-api-market-key (default). RapidAPI: https://aerodatabox.p.rapidapi.com
# FD_AERODATABOX_BASE=https://prod.api.market/api/v1/aedbx/aerodatabox
# Rolling 30-day unit guard below the plan's hard limit (Pro: 5,000 units)
# FD_AERODATABOX_UNIT_BUDGET=4750
# FD_SWEDAVIA_KEY=
# Optional capped gate sampling from FCO detail pages (~670 kB each); 0 = off
FD_FCO_DETAIL_MAX=0
